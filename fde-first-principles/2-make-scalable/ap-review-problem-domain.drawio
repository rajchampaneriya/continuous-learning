                <mxCell id="p1-v76" parent="p1-v75" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontColor=#000000;fontSize=11;" value="• Document prompt injection: treat doc text as data, Prompt Shields, tool allow-list&lt;br&gt;• Unauthorized evidence access: ACL filters + per-tool authz&lt;br&gt;• Sensitive info: PII redaction in outputs and logs&lt;br&gt;• Foundry controls: content-filter severity, protected material, groundedness, blocklists, task adherence (preview limits)&lt;br&gt;• &lt;b&gt;Financial validation + human approval stay in the application&lt;/b&gt;" vertex="1">
                    <mxGeometry height="136" width="449" x="8" y="42" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v77" parent="1" style="swimlane;startSize=36;rounded=0;fillColor=#000000;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;collapsible=0;" value="Reliability &amp;amp; Operations" vertex="1">
