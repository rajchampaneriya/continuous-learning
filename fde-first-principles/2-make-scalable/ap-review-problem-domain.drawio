<mxfile host="65bd71144e">
    <diagram id="p0" name="0 · Problem Definition (SCOPE-D)">
        <mxGraphModel dx="881" dy="367" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1270" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p0-v1" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=22;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;" value="ACMEFibre — Problem Definition (SCOPE-D: S · C · O)" vertex="1">
                    <mxGeometry height="56" width="1920" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v2" parent="1" style="fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=13;rounded=0;whiteSpace=wrap;html=1;align=center;spacing=8;" value="&lt;b&gt;Value story:&lt;/b&gt; clerks stop matching and start judging exceptions — 6.5 FTE of manual matching becomes ~1 FTE of review, late-payment penalties and duplicate payments drop to near-zero, and every decision survives audit." vertex="1">
                    <mxGeometry height="50" width="1920" x="40" y="86" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v3" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;" value="S — What problem? Actor → Problem → Outcome" vertex="1">
                    <mxGeometry height="36" width="1920" x="40" y="156" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v4" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Actor&lt;/b&gt;&lt;br&gt;&lt;br&gt;ACMEFibre — fibre-optic distributor&lt;br&gt;Account Payable team: 11 staff&lt;br&gt;Volume: 3,800 supplier invoices / month&lt;br&gt;Evidence arrives as:&lt;br&gt;• digital PDFs (invoices, POs)&lt;br&gt;• warehouse phone photos (deliveries, receipts)&lt;br&gt;• occasional mixed scan packet" vertex="1">
                    <mxGeometry height="230" width="580" x="40" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v5" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Problem&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manual 3-way match: clerk hunts PO + goods receipt, eyeballs quantities and totals, chases warehouse for photos. Avg 4 days per invoice.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cost of status quo&lt;/b&gt;&lt;br&gt;• £38k/yr late-payment penalties (2% of invoices)&lt;br&gt;• 1–2 duplicate payments / quarter (~£9k each)&lt;br&gt;• ~6.5 FTE of pure matching&lt;br&gt;• zero evidence trail → audit findings every year" vertex="1">
                    <mxGeometry height="230" width="600" x="680" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v6" parent="1" style="rounded=0;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b style=&quot;color: rgb(255, 255, 255);&quot;&gt;Outcome&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every invoice gets a decision — ready_for_approval · needs_review · reject — with cited evidence, in minutes not days.&lt;br&gt;Humans approve. Auditors get a trail, not a phone call.&lt;br&gt;&lt;br&gt;&lt;span&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;Reframe&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;:&lt;/span&gt;&lt;/b&gt; &lt;/span&gt;&lt;span&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;the problem is not &quot;reading invoices&quot;. It is &lt;/span&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;proving payability with evidence, at volume&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;, when the evidence is a blurry photo&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;.&lt;/span&gt;&lt;/span&gt;" vertex="1">
                    <mxGeometry height="230" width="640" x="1320" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="p0-e7" edge="1" parent="1" source="p0-v4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p0-v5" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p0-e8" edge="1" parent="1" source="p0-v5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p0-v6" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v9" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;" value="C — What part of it? Core use case · Exclusions · Assumptions" vertex="1">
                    <mxGeometry height="36" width="1920" x="40" y="466" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v10" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;CORE (this build)&lt;/b&gt;&lt;br&gt;&lt;br&gt;One invoice in → one cited decision out.&lt;br&gt;Evidence = invoice + PO + goods receipt (document and/or photo), including one mixed PDF packet.&lt;br&gt;3 labeled scenarios: clean digital invoice · noisy photo · 3-way mismatch.&lt;br&gt;&lt;br&gt;&lt;i&gt;&quot;Decide payability of INV-2026-1187 against its PO and goods receipt — where the goods receipt is a tilted phone photo — and show which region of which document proves it.&quot;&lt;/i&gt;" vertex="1">
                    <mxGeometry height="200" width="620" x="40" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v11" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;EXCLUDED&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Real payments / ERP posting (simulated locally)&lt;br&gt;• Multi-language invoices&lt;br&gt;• Custom model training&lt;br&gt;• Supplier portal / inbound ETL&lt;br&gt;• Backfill of 400k-document archive&lt;br&gt;• Historical spend analytics" vertex="1">
                    <mxGeometry height="200" width="620" x="690" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v12" parent="1" style="rounded=0;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;ASSUMED&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Synthetic labeled data covers the real distribution&lt;br&gt;• English documents · GBP / EUR&lt;br&gt;• POs and goods receipts already exist in source systems&lt;br&gt;• Azure AI Foundry, Content Understanding, AI Search available in demo tier" vertex="1">
                    <mxGeometry height="200" width="590" x="1340" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v13" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;" value="O — Under what rules? Constraints · Guarantees · Load · SLO" vertex="1">
                    <mxGeometry height="36" width="1920" x="40" y="746" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v14" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;CONSTRAINTS (given)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• CU agentic mode preview: one file · documents only · no extract-method fields&lt;br&gt;• Human gate on posting&lt;br&gt;• Synthetic data only&lt;br&gt;• Demo Azure tier budget&lt;br&gt;• Max 3 analyzers: invoice · layout · receipt" vertex="1">
                    <mxGeometry height="220" width="465" x="40" y="800" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v15" parent="1" style="rounded=0;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b style=&quot;color: rgb(255, 255, 255);&quot;&gt;GUARANTEES (committed)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Model confidence NEVER authorizes approval&lt;br&gt;• Every decision cites a source region or is needs_review&lt;br&gt;• Replay → same result, no duplicate post&lt;br&gt;• Injection inside document text never escalates&lt;br&gt;• PII redacted in outputs and logs&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: rgb(255, 255, 255);&quot;&gt;Non-negotiable: cited evidence or no decision.&lt;/b&gt;" vertex="1">
                    <mxGeometry height="220" width="465" x="525" y="800" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v16" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;LOAD&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 3 labeled scenarios&lt;br&gt;• 8 demonstration checks&lt;br&gt;• Mixed packet up to 30 pages&lt;br&gt;• Documents + standalone JPEG/PNG photos&lt;br&gt;• Replayed request for duplicate prevention" vertex="1">
                    <mxGeometry height="220" width="465" x="1010" y="800" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v17" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;SLO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Decision ≤ 90 s per invoice — request deadline enforced, not best-effort&lt;br&gt;• 99% of requests decide within SLO&lt;br&gt;• Stale citation → automatic needs_review&lt;br&gt;• Failed dependency → bounded retry + audit event, never a hang" vertex="1">
                    <mxGeometry height="220" width="465" x="1495" y="800" as="geometry"/>
                </mxCell>
                <mxCell id="p0-v18" parent="1" style="fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=13;rounded=0;whiteSpace=wrap;html=1;align=center;spacing=8;" value="&lt;b&gt;Next in SCOPE-D:&lt;/b&gt; P (behavior — process flow, states, interaction) → E (structure — see pages 1–2) → D (destroy — stress the non-negotiable: blurry photo at volume, injected packet, stale index under re-index)" vertex="1">
                    <mxGeometry height="56" width="1920" x="40" y="1050" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="p1" name="1 · Problem Domain Context">
        <mxGraphModel dx="3019" dy="1260" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1270" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p1-v1" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=22;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;" value="Accounts Payable · Document &amp;amp; Image Review Agent — Problem Domain" vertex="1">
                    <mxGeometry height="56" width="1920" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v2" parent="1" style="fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=13;rounded=0;whiteSpace=wrap;html=1;align=center;spacing=8;" value="&lt;b&gt;Core question:&lt;/b&gt; Is this supplier invoice payable? Prove it with a deterministic &lt;b&gt;3-way match (Invoice ↔ Purchase Order ↔ Goods Receipt)&lt;/b&gt; using cited, grounded evidence from documents &lt;b&gt;and&lt;/b&gt; photos.&lt;br&gt;Outcome per request: &lt;b&gt;ready_for_approval&lt;/b&gt; · &lt;b&gt;needs_review&lt;/b&gt; · &lt;b&gt;reject&lt;/b&gt; — payment/posting is simulated locally and always gated by human confirmation." vertex="1">
                    <mxGeometry height="66" width="1920" x="40" y="86" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v3" parent="1" style="swimlane;startSize=36;rounded=0;fillColor=#000000;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;collapsible=0;" value="Actors &amp;amp; Trust Boundary" vertex="1">
                    <mxGeometry height="760" width="210" x="40" y="172" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v4" parent="p1-v3" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Supplier&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;external · untrusted content&lt;/font&gt;" vertex="1">
                    <mxGeometry height="56" width="40" x="85" y="52" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v5" parent="p1-v3" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Purchasing / Warehouse&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;issues PO · records receipt&lt;/font&gt;" vertex="1">
                    <mxGeometry height="56" width="40" x="85" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v6" parent="p1-v3" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" value="&lt;b&gt;AP Clerk (Reviewer)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;works needs_review cases&lt;/font&gt;" vertex="1">
                    <mxGeometry height="56" width="40" x="85" y="288" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v7" parent="p1-v3" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" value="&lt;b&gt;AP Approver&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;human confirmation to post&lt;/font&gt;" vertex="1">
                    <mxGeometry height="56" width="40" x="85" y="406" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v8" parent="p1-v3" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Auditor / Evaluator&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;audit trail · eval reports&lt;/font&gt;" vertex="1">
                    <mxGeometry height="56" width="40" x="85" y="524" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v9" parent="p1-v3" style="shape=note;size=14;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;Access boundary&lt;/b&gt;&lt;br&gt;Evidence scoped per business unit / cost centre; every retrieval and tool call is security-trimmed." vertex="1">
                    <mxGeometry height="96" width="186" x="12" y="650" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v10" parent="1" style="swimlane;startSize=36;rounded=0;fillColor=#000000;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;collapsible=0;" value="① Inputs — synthetic &amp;amp; labeled" vertex="1">
                    <mxGeometry height="760" width="300" x="270" y="172" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v11" parent="p1-v10" style="shape=document;size=0.12;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;Clean digital invoice&lt;/b&gt; (PDF)&lt;br&gt;Scenario S1" vertex="1">
                    <mxGeometry height="60" width="270" x="15" y="50" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v12" parent="p1-v10" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;Noisy invoice photo&lt;/b&gt; (JPEG/PNG)&lt;br&gt;Scenario S2 · blur, skew, glare" vertex="1">
                    <mxGeometry height="60" width="270" x="15" y="122" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v13" parent="p1-v10" style="shape=document;size=0.12;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;Purchase Order&lt;/b&gt; (PDF)&lt;br&gt;ordered qty · agreed unit price" vertex="1">
                    <mxGeometry height="60" width="270" x="15" y="194" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v14" parent="p1-v10" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;Delivery / receipt photo&lt;/b&gt;&lt;br&gt;received qty · condition · signature" vertex="1">
                    <mxGeometry height="60" width="270" x="15" y="266" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v15" parent="p1-v10" style="shape=document;size=0.12;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;Mixed packet&lt;/b&gt; (single PDF)&lt;br&gt;invoice + PO + receipt + unknown page" vertex="1">
                    <mxGeometry height="66" width="270" x="15" y="338" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v16" parent="p1-v10" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Ground-truth labels&lt;/b&gt;&lt;br&gt;expected critical fields + expected decision" vertex="1">
                    <mxGeometry height="62" width="270" x="15" y="418" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v17" parent="p1-v10" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Labeled scenarios&lt;/b&gt;&lt;br&gt;S1 Clean digital invoice → ready_for_approval&lt;br&gt;S2 Noisy invoice photo → needs_review (low confidence / unreadable)&lt;br&gt;S3 Invoice · PO · receipt mismatch → reject (or needs_review if evidence is insufficient)" vertex="1">
                    <mxGeometry height="150" width="270" x="15" y="494" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v18" parent="p1-v10" style="shape=note;size=14;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;All inputs are untrusted&lt;/b&gt;&lt;br&gt;May carry prompt-injection text, PII, rotated or unreadable regions." vertex="1">
                    <mxGeometry height="88" width="270" x="15" y="658" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v19" parent="1" style="swimlane;startSize=36;rounded=0;fillColor=#000000;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;collapsible=0;" value="② Understand — Content Understanding" vertex="1">
                    <mxGeometry height="760" width="360" x="590" y="172" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v20" parent="p1-v19" style="rounded=0;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" value="&lt;b&gt;Classify · split · route&lt;/b&gt; (mixed packet)&lt;br&gt;invoice | PO | receipt | unknown → needs_review" vertex="1">
                    <mxGeometry height="62" width="330" x="15" y="50" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v21" parent="p1-v19" style="rounded=0;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=10;whiteSpace=wrap;html=1;align=center;spacingLeft=2;spacingRight=6;verticalAlign=middle;" value="prebuilt-&lt;br&gt;invoice" vertex="1">
                    <mxGeometry height="50" width="78" x="15" y="124" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v22" parent="p1-v19" style="rounded=0;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=10;whiteSpace=wrap;html=1;align=center;spacingLeft=2;spacingRight=6;verticalAlign=middle;" value="custom PO&lt;br&gt;analyzer" vertex="1">
                    <mxGeometry height="50" width="78" x="99" y="124" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v23" parent="p1-v19" style="rounded=0;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=10;whiteSpace=wrap;html=1;align=center;spacingLeft=2;spacingRight=6;verticalAlign=middle;" value="prebuilt-&lt;br&gt;receipt" vertex="1">
                    <mxGeometry height="50" width="78" x="183" y="124" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v24" parent="p1-v19" style="rounded=0;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=10;whiteSpace=wrap;html=1;align=center;spacingLeft=2;spacingRight=6;verticalAlign=middle;" value="prebuilt-&lt;br&gt;layout" vertex="1">
                    <mxGeometry height="50" width="78" x="267" y="124" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v25" parent="p1-v19" style="rounded=0;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" value="&lt;b&gt;Field pipeline&lt;/b&gt;&lt;br&gt;OCR → layout/tables → fields (extract | classify | generate) → grounding + confidence" vertex="1">
                    <mxGeometry height="56" width="330" x="15" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v26" parent="p1-v19" style="shape=document;size=0.12;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;Output: Markdown + typed Invoice JSON&lt;/b&gt;&lt;br&gt;supplier · IDs · dates · currency · line items · tax · totals&lt;br&gt;raw + normalized value · source region (page, bbox) · field confidence" vertex="1">
                    <mxGeometry height="96" width="330" x="15" y="254" as="geometry"/>
                </mxCell>
                <mxCell id="p1-v27" parent="p1-v19" style="rounded=0;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" value="&lt;b&gt;Image understanding&lt;/b&gt; (vision-capable model)&lt;br&gt;OCR text ≠ visual observation (e.g. &#39;damaged pallet&#39;, &#39;3 cartons&#39;)&lt;br&gt;cite image regions · flag unreadable / conflicting evidence" vertex="1">
