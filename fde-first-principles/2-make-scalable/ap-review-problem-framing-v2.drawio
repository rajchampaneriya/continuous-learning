    <diagram id="k2" name="2 · S: who has which problem?">
        <mxGraphModel dx="1647" dy="963" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="k2-1" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=22;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=16;" value="Step 2 · SCOPE-D S: Actor → Problem → Outcome (re-opened)" vertex="1">
                    <mxGeometry height="56" width="1620" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="k2-2" parent="1" style="fillColor=#F5F5F5;strokeColor=none;fontColor=#222222;fontSize=13;rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=16;spacingRight=16;" value="v1 put &lt;i&gt;the organisation&lt;/i&gt; in the Actor box and assumed one problem. SCOPE-D asks for &lt;b&gt;one&lt;/b&gt; actor, &lt;b&gt;one&lt;/b&gt; problem and &lt;b&gt;one&lt;/b&gt; outcome. We have three candidate problems, and different people feel each one." vertex="1">
                    <mxGeometry height="50" width="1620" x="40" y="86" as="geometry"/>
                </mxCell>
                <mxCell id="k2-3" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;align=center;" value="ACTOR: who feels it, who pays for it" vertex="1">
                    <mxGeometry height="36" width="440" x="40" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="k2-4" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;align=center;" value="PROBLEM: competing hypotheses" vertex="1">
                    <mxGeometry height="36" width="520" x="560" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="k2-5" parent="1" style="fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;align=center;" value="OUTCOME: what would prove it improved" vertex="1">
                    <mxGeometry height="36" width="500" x="1160" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="k2-6" parent="1" style="fillColor=#FFF4E0;strokeColor=#C77700;dashed=1;fontColor=#000000;fontSize=12;rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Feel the friction every day&lt;/b&gt;&lt;br&gt;AP clerks: hunt for evidence, compare by eye&lt;br&gt;Warehouse staff: get chased for receipts&lt;br&gt;Buyers: get queried about prices" vertex="1">
                    <mxGeometry height="110" width="440" x="40" y="212" as="geometry"/>
                </mxCell>
                <mxCell id="k2-7" parent="1" style="fillColor=#FFF4E0;strokeColor=#C77700;dashed=1;fontColor=#000000;fontSize=12;rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Bear the consequences&lt;/b&gt;&lt;br&gt;Finance controller / CFO: penalties, cash leakage&lt;br&gt;Suppliers: paid late, chase payment&lt;br&gt;Auditors: no trail, raise findings" vertex="1">
